@inherits LayoutComponentBase
@using MistyStep.Services
@inject LanguagePreferenceService LanguagePreferences
@inject ThemePreferenceService ThemePreferences
@inject IStringLocalizer<SharedResource> Localizer
@implements IDisposable
<MudThemeProvider Theme="@AppTheme" IsDarkMode="@ThemePreferences.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true"
    CloseButton="true"
    BackdropClick="false"
    NoHeader="true"
    Position="DialogPosition.Center"
    CloseOnEscapeKey="true"
    BackgroundClass="my-custom-class"
    />
<MudSnackbarProvider />

<div class="app-shell @(ThemePreferences.IsDarkMode ? "app-shell-dark" : string.Empty)">
    <header class="app-header">
        <a class="app-brand" href="" aria-label="@Localizer["Home"]">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1">MistyStep</MudText>
        </a>
        <div class="app-header-meta">
            <MudText Typo="Typo.caption" Class="app-header-label">@Localizer["Circuit training"]</MudText>
            <MudIconButton Href="/settings" Icon="@Icons.Material.Outlined.Settings" Color="Color.Default" aria-label="@Localizer["Settings"]" title="@Localizer["Settings"]" />
        </div>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>

@code {
    private static readonly MudTheme AppTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#176B5B",
            Secondary = "#466B86",
            Tertiary = "#9A633A",
            Info = "#3E8295",
            Success = "#397457",
            Warning = "#A96C25",
            Error = "#B34D4D",
            Background = "#F3F6F4",
            Surface = "#FFFFFF",
            TextPrimary = "#1D3029",
            TextSecondary = "#64736D",
            Divider = "#E1E8E4",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1D3029"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#75C7A8",
            Secondary = "#A2B9CB",
            Tertiary = "#DDA978",
            Info = "#8AC9D5",
            Success = "#8AC69E",
            Warning = "#E5B66F",
            Error = "#E18A84",
            Background = "#171F1B",
            Surface = "#222C27",
            TextPrimary = "#E8F0EB",
            TextSecondary = "#B0BEB6",
            Divider = "#36423B",
            AppbarBackground = "#202923",
            AppbarText = "#E8F0EB"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        ThemePreferences.ThemeChanged += HandleThemeChanged;
        LanguagePreferences.LanguageChanged += HandleLanguageChanged;
        await ThemePreferences.InitializeAsync();
        await LanguagePreferences.InitializeAsync();
    }

    protected override void OnParametersSet() => LanguagePreferences.ApplyCurrentCulture();

    private void HandleThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleLanguageChanged() => _ = InvokeAsync(() =>
    {
        LanguagePreferences.ApplyCurrentCulture();
        StateHasChanged();
    });

    public void Dispose()
    {
        ThemePreferences.ThemeChanged -= HandleThemeChanged;
        LanguagePreferences.LanguageChanged -= HandleLanguageChanged;
    }
}


