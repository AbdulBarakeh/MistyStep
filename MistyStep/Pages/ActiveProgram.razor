@page "/run/program/{Id:guid}";
@using MistyStep.Models
@using MistyStep.Services
@inject IStringLocalizer<SharedResource> Localizer
<div class="active-program-page">

    @if (Initialized)
    {
        @if (Program is not null)
        {
            <MudPaper Class="active-program-heading" Outlined="true" Elevation="0">
                <MudText Typo="Typo.overline" Class="active-kicker">@Localizer["Program heading"]</MudText>
                <MudText Typo="Typo.h6">@Program.Name</MudText>
            </MudPaper>
        }

        @if (CurrentExercise is not null && Program is not null)
        {
            <MudPaper Class="active-exercise-panel" Outlined="true" Elevation="0">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Class="active-kicker">@Localizer["EXERCISE {0} OF {1}", CurrentExerciseIndex + 1, ProgramExercises.Length]</MudText>
                    <MudText Typo="Typo.h4">@CurrentExercise.Name</MudText>
                    @if (NextExercise is not null)
                    {
                        <MudText Typo="Typo.body2" Class="catalog-item-detail">@Localizer["UP NEXT · {0}", NextExercise.Name]</MudText>
                    }
                </MudStack>
            </MudPaper>
        }

        <MudPaper Class="repetition-panel" Outlined="true" Elevation="0">
            <MudNumericField @key="CurrentExerciseIndex" @ref="Input" T="double" @bind-Value="InputValue" Label="@Localizer["Repetitions"]" Variant="Variant.Outlined" Min="0" />
        </MudPaper>

        @if (Program!.ExerciseDurationInSeconds is not null)
        {
            <MistyStep.Components.Timer @ref="TimerComp" OnTimerEnd="TimerEnd" OnPauseTimerEnd="GoToNextExercise"></MistyStep.Components.Timer>
        }

        <div class="active-actions">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.SkipNext" OnClick="GoToNextExercise">@Localizer["Next exercise"]</MudButton>
            <MudButton Color="Color.Default" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Assessment" OnClick="GoToResult">@Localizer["Results"]</MudButton>
            <MudButton Color="Color.Default" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Close" OnClick="GoToOverview">@Localizer["Exit"]</MudButton>
        </div>
    }
    else
    {
        <MudStack Spacing="2">
            <MudSkeleton Height="76px" />
            <MudSkeleton Height="180px" />
            <MudSkeleton Height="72px" />
        </MudStack>
    }

</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    [Inject]
    public IExerciseService ExerciseService { get; set; } = null!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = null!;

    public ExerciseProgram? Program { get; set; }

    public Exercise[] ProgramExercises { get; set; } = [];

    public Exercise? CurrentExercise { get; set; }

    public Exercise? NextExercise { get; set; }

    public ExerciseRecord? LastExerciseRecord { get; set; }

    public DateTime StartTime { get; set; }

    public Components.Timer? TimerComp { get; set; }

    private int CurrentExerciseIndex { get; set; } = 0;

    private MudNumericField<double>? Input { get; set; }

    private double InputValue { get; set; } = 0;

    private bool Initialized { get; set; }

    private bool IsAdvancing { get; set; }

    private bool IsInitialTimerStarted { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {

            await InitialDataLoad();
            StateHasChanged();
        }

        if (Initialized && !IsInitialTimerStarted && TimerComp is not null && Program?.ExerciseDurationInSeconds is int duration)
        {
            IsInitialTimerStarted = true;
            await TimerComp.StartTimer(duration, false);
        }

    }


    private async Task InitialDataLoad()
    {
        StartTime = DateTime.UtcNow;
        var programResult = await ExerciseService.GetExerciseProgramById(Id);

        if (!programResult.IsSuccess)
        {
            // Program not found
            return;
        }

        Program = programResult.Data;

        var exercisesResult = await ExerciseService.GetExercisesByIds(Program!.ExerciseIds);
        if (!exercisesResult.IsSuccess)
        {
            // Exercises not found
            return;
        }

        ProgramExercises = exercisesResult.Data!.ToArray();
        Initialized = true;
        await UpdateExerciseCounter();
    }

    private async Task UpdateExerciseCounter()
    {
        CurrentExercise = ProgramExercises[CurrentExerciseIndex];

        if (CurrentExerciseIndex < ProgramExercises.Length - 1)
        {
            NextExercise = ProgramExercises[CurrentExerciseIndex + 1];
        }
        else
        {
            NextExercise = null;
        }

        var recordResult = await ExerciseService.GetExerciseRecordById(CurrentExercise.Id, Program!.Id);
        if (recordResult.IsSuccess)
        {
            LastExerciseRecord = recordResult.Data;
        }
        else
        {
            LastExerciseRecord = null;
        }
    }

    private async Task TimerEnd()
    {
        if (Program?.PauseDurationInSeconds is int pauseDuration)
        {
            await TimerComp!.StartTimer(pauseDuration, true);
            return;
        }

        await GoToNextExercise();
    }


    private async Task GoToNextExercise()
    {
        if (IsAdvancing || CurrentExercise is null || Program is null)
        {
            return;
        }

        IsAdvancing = true;
        await DisposeTimers();
        var exerciseRecord = new ExerciseRecord(Guid.NewGuid(), StartTime, CurrentExercise!.Id, Program!.Id, InputValue);
        await ExerciseService.CreateNewExerciseRecord(exerciseRecord);

        if (CurrentExerciseIndex == ProgramExercises.Length - 1)
        {
            // Program is done
            await GoToResult();
            return;
        }

        CurrentExerciseIndex++;

        await UpdateExerciseCounter();
        InputValue = 0;
        IsAdvancing = false;
        await InvokeAsync(StateHasChanged);

        if (Program.ExerciseDurationInSeconds is int duration)
        {
            await TimerComp!.StartTimer(duration, false);
        }
    }

    private async Task GoToResult()
    {
        await DisposeTimers();
        NavigationManager.NavigateTo($"result/{Program!.Id}?time={StartTime}");
    }

    private async Task GoToOverview()
    {
        await DisposeTimers();
        NavigationManager.NavigateTo("");
    }
    private async Task DisposeTimers()
    {
        if (TimerComp is not null)
        {
            await TimerComp.DisposeTimers();
        }
    }
}
