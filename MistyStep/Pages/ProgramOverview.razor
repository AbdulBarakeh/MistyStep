@using MistyStep.Components
@using MistyStep.Services
@using System.Collections.ObjectModel
<div class="catalog-page">
    <div class="catalog-scroll">
        <MudStack Class="catalog-list" Spacing="0">
            @if (Programs is { Count: > 0 })
            {
                @foreach (var program in Programs)
                {
                    <MudPaper Class="catalog-item" Outlined="true" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.subtitle1" Class="catalog-item-title">@program.Name</MudText>
                                <MudStack Row="true" Spacing="0" Class="catalog-actions">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" aria-label="Edit program" title="Edit program" OnClick="@(() => EditProgram(program))" />
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.FileDownload" aria-label="Export program with exercises and point table" title="Export program" OnClick="@(() => ExportProgram(program))" />
                                </MudStack>
                            </MudStack>
                            <MudStack Row="true" Class="program-card-actions" Spacing="1">
                                <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => RunProgram(program.Id))">Run program</MudButton>
                                <MudButton Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Insights" OnClick="@(() => GoToRecords(program.Id))">Records</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            }
            else if (IsLoaded)
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><MudIcon Icon="@Icons.Material.Outlined.FactCheck" Size="Size.Large" /></div>
                    <MudText Typo="Typo.h6">No programs yet</MudText>
                    <MudText Typo="Typo.body2" Class="empty-state-copy">Create a circuit from your exercise catalog, or import a program to get started.</MudText>
                </div>
            }
            else
            {
                <MudSkeleton Height="92px" />
                <MudSkeleton Height="92px" />
            }
        </MudStack>
    </div>
    <InputFile id="programImportInput" style="display:none" OnChange="ImportFile" accept=".json,application/json" />
    <MudFabMenu StartIcon="@Icons.Material.Filled.MoreVert" Color="Color.Primary" @bind-Open="IsFabExpanded" Fixed="true" OpenOnMouseHover="false">
        <MudFabMenuItem StartIcon="@Icons.Material.Filled.Add" aria-label="Create program" title="Create program" OnClick="GoToProgramCreation" />
        <MudFabMenuItem StartIcon="@Icons.Material.Filled.FileUpload" aria-label="Import exercises or a program" title="Import exercises or a program" OnClick="ImportClick" />
    </MudFabMenu>
</div>
@code {

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [Inject] IDialogService DialogService { get; set; } = null!;

    [Inject] IExerciseService ExerciseService { get; set; } = null!;

    [Inject] IJSRuntime JSRuntime { get; set; } = null!;

    [Inject] ISnackbar Snackbar { get; set; } = null!;

    public ObservableCollection<Models.ExerciseProgram> Programs { get; set; } = [];

    private bool IsFabExpanded { get; set; }

    private bool IsLoaded { get; set; }

    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var exerciseProgramsResult = await ExerciseService.GetExercisePrograms();
            if (!exerciseProgramsResult.IsSuccess)
            {
                IsLoaded = true;
                StateHasChanged();
                return;
            }
            exerciseProgramsResult.Data!.ForEach(program => Programs.Add(program));
            IsLoaded = true;
            StateHasChanged();
        }

    }

    private async Task GoToProgramCreation()
    {
        IsFabExpanded = false;
        var temp = await DialogService.ShowAsync<CreateExerciseProgramDialog>();
        _ = await temp.Result;

        await ReloadPrograms();

    }

    private void ToggleFab() => IsFabExpanded = !IsFabExpanded;

    private async Task ImportClick()
    {
        IsFabExpanded = false;
        await JSRuntime.InvokeVoidAsync("clickMistyStepFileInput", "programImportInput");
    }

    private async Task EditProgram(Models.ExerciseProgram program)
    {
        var parameters = new DialogParameters { ["ProgramToEdit"] = program };
        var dialog = await DialogService.ShowAsync<CreateExerciseProgramDialog>("Edit program", parameters);
        _ = await dialog.Result;
        await ReloadPrograms();
    }

    private async Task ReloadPrograms()
    {
        Programs.Clear();
        var result = await ExerciseService.GetExercisePrograms();
        if (result.IsSuccess)
        {
            result.Data!.ForEach(program => Programs.Add(program));
        }

        StateHasChanged();
    }

    private async Task ExportProgram(Models.ExerciseProgram program)
    {
        var json = await ExerciseService.ExportProgramAsync(program.Id);
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        await JSRuntime.InvokeVoidAsync("downloadMistyStepFile", $"mistystep-program-{program.Name}.json", base64);
    }

    private async Task ImportFile(InputFileChangeEventArgs args)
    {
        IsFabExpanded = false;
        if (string.IsNullOrWhiteSpace(args.File.Name))
        {
            return;
        }

        try
        {
            await using var stream = args.File.OpenReadStream(1_000_000);
            using var reader = new StreamReader(stream);
            await ExerciseService.ImportDataAsync(await reader.ReadToEndAsync());
            await ReloadPrograms();
            Snackbar.Add("Import completed.", Severity.Success);
        }
        catch (Exception exception)
        {
            Snackbar.Add($"Import failed: {exception.Message}", Severity.Error);
        }
    }

    private void RunProgram(Guid id)
    {
        NavigationManager.NavigateTo($"run/program/{id}");
    }

    private void GoToRecords(Guid id)
    {
        NavigationManager.NavigateTo($"record/program/{id}");
    }
}