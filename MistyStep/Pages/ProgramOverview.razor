@using MistyStep.Components
@using MistyStep.Services
@using System.Collections.ObjectModel
@inject IStringLocalizer<SharedResource> Localizer
<div class="catalog-page">
    <div class="catalog-scroll">
        <MudStack Class="catalog-list" Spacing="0">
            @if (Programs is { Count: > 0 })
            {
                @foreach (var program in Programs)
                {
                    <MudPaper Class="catalog-item" Outlined="true" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.subtitle1" Class="catalog-item-title">@program.Name</MudText>
                                <MudStack Row="true" Spacing="0" Class="catalog-actions">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" aria-label="@Localizer["Edit program"]" title="@Localizer["Edit program"]" OnClick="@(() => EditProgram(program))" />
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.FileDownload" aria-label="@Localizer["Export program with exercises and point table"]" title="@Localizer["Export program"]" OnClick="@(() => ExportProgram(program))" />
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" aria-label="@Localizer["Delete program"]" title="@Localizer["Delete program"]" OnClick="@(() => DeleteProgram(program))" />
                                </MudStack>
                            </MudStack>
                            <MudStack Row="true" Class="program-card-actions" Spacing="1">
                                <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => RunProgram(program.Id))">@Localizer["Run program"]</MudButton>
                                <MudButton Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Insights" OnClick="@(() => GoToRecords(program.Id))">@Localizer["Records"]</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            }
            else if (IsLoaded)
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><MudIcon Icon="@Icons.Material.Outlined.FactCheck" Size="Size.Large" /></div>
                    <MudText Typo="Typo.h6">@Localizer["No programs yet"]</MudText>
                    <MudText Typo="Typo.body2" Class="empty-state-copy">@Localizer["Create a circuit from your exercise catalog, or import a program to get started."]</MudText>
                </div>
            }
            else
            {
                <MudSkeleton Height="92px" />
                <MudSkeleton Height="92px" />
            }
        </MudStack>
    </div>
    <InputFile id="programImportInput" style="display:none" OnChange="ImportFile" accept=".json,application/json" />
    <MudFabMenu StartIcon="@Icons.Material.Filled.MoreVert" Color="Color.Primary" @bind-Open="IsFabExpanded" Fixed="true" OpenOnMouseHover="false">
        <MudFabMenuItem StartIcon="@Icons.Material.Filled.Add" aria-label="@Localizer["Create program"]" title="@Localizer["Create program"]" OnClick="GoToProgramCreation" />
        <MudFabMenuItem StartIcon="@Icons.Material.Filled.FileUpload" aria-label="@Localizer["Import exercises or a program"]" title="@Localizer["Import exercises or a program"]" OnClick="ImportClick" />
    </MudFabMenu>
</div>
@code {

    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [Inject] IDialogService DialogService { get; set; } = null!;

    [Inject] IExerciseService ExerciseService { get; set; } = null!;

    [Inject] IJSRuntime JSRuntime { get; set; } = null!;

    [Inject] ISnackbar Snackbar { get; set; } = null!;

    public ObservableCollection<Models.ExerciseProgram> Programs { get; set; } = [];

    private bool IsFabExpanded { get; set; }

    private bool IsLoaded { get; set; }

    

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var exerciseProgramsResult = await ExerciseService.GetExercisePrograms();
            if (!exerciseProgramsResult.IsSuccess)
            {
                IsLoaded = true;
                StateHasChanged();
                return;
            }
            exerciseProgramsResult.Data!.ForEach(program => Programs.Add(program));
            IsLoaded = true;
            StateHasChanged();
        }

    }

    private async Task GoToProgramCreation()
    {
        IsFabExpanded = false;
        var temp = await DialogService.ShowAsync<CreateExerciseProgramDialog>();
        _ = await temp.Result;

        await ReloadPrograms();

    }

    private void ToggleFab() => IsFabExpanded = !IsFabExpanded;

    private async Task ImportClick()
    {
        IsFabExpanded = false;
        await JSRuntime.InvokeVoidAsync("clickMistyStepFileInput", "programImportInput");
    }

    private async Task EditProgram(Models.ExerciseProgram program)
    {
        var parameters = new DialogParameters { ["ProgramToEdit"] = program };
        var dialog = await DialogService.ShowAsync<CreateExerciseProgramDialog>(Localizer["Edit program"], parameters);
        _ = await dialog.Result;
        await ReloadPrograms();
    }

    private async Task ReloadPrograms()
    {
        Programs.Clear();
        var result = await ExerciseService.GetExercisePrograms();
        if (result.IsSuccess)
        {
            result.Data!.ForEach(program => Programs.Add(program));
        }

        StateHasChanged();
    }

    private async Task ExportProgram(Models.ExerciseProgram program)
    {
        var json = await ExerciseService.ExportProgramAsync(program.Id);
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        await JSRuntime.InvokeVoidAsync("downloadMistyStepFile", $"mistystep-program-{program.Name}.json", base64);
    }

    private async Task DeleteProgram(Models.ExerciseProgram program)
    {
        var parameters = new DialogParameters
        {
            ["ItemType"] = Localizer["Delete type program"].Value,
            ["ItemName"] = program.Name,
            ["Details"] = Localizer["This also deletes all workout records for this program."].Value
        };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(Localizer["Delete program"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await ExerciseService.DeleteExerciseProgramAsync(program.Id);
        Snackbar.Add(Localizer["Program deleted."], Severity.Success);
        await ReloadPrograms();
    }

    private async Task ImportFile(InputFileChangeEventArgs args)
    {
        IsFabExpanded = false;
        var file = args.GetMultipleFiles().FirstOrDefault();
        if (file is null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(1_000_000);
            using var reader = new StreamReader(stream);
            await ExerciseService.ImportDataAsync(await reader.ReadToEndAsync());
            await ReloadPrograms();
            Snackbar.Add(Localizer["Import completed."], Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Localizer["Import failed. Make sure the file is a valid MistyStep export."], Severity.Error);
        }
    }

    private void RunProgram(Guid id)
    {
        NavigationManager.NavigateTo($"run/program/{id}");
    }

    private void GoToRecords(Guid id)
    {
        NavigationManager.NavigateTo($"record/program/{id}");
    }
}