@using MistyStep.Components
@using MistyStep.Models
@using MistyStep.Services
@using System.Collections.ObjectModel
@inject IStringLocalizer<SharedResource> Localizer
<div class="catalog-page">
    <div class="catalog-scroll">
        <MudStack Class="catalog-list" Spacing="0">
            @if (Exercises is { Count: > 0 })
            {
                @foreach (var exercise in Exercises)
                {
                    <MudPaper Class="catalog-item" Outlined="true" Elevation="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="catalog-item-title">@exercise.Name</MudText>
                                <MudText Typo="Typo.body2" Class="catalog-item-detail">@exercise.PointsPerRep @Localizer["Points per rep"]</MudText>
                            </div>
                            <MudStack Row="true" Spacing="0" Class="catalog-actions">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" aria-label="@Localizer["Edit exercise"]" title="@Localizer["Edit exercise"]" OnClick="@(() => EditExercise(exercise))" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.FileDownload" aria-label="@Localizer["Export exercise"]" title="@Localizer["Export exercise"]" OnClick="@(() => ExportExercise(exercise))" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" aria-label="@Localizer["Delete exercise"]" title="@Localizer["Delete exercise"]" OnClick="@(() => DeleteExercise(exercise))" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            }
            else if (IsLoaded)
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><MudIcon Icon="@Icons.Material.Outlined.FitnessCenter" Size="Size.Large" /></div>
                    <MudText Typo="Typo.h6">@Localizer["No exercises yet"]</MudText>
                    <MudText Typo="Typo.body2" Class="empty-state-copy">@Localizer["Add an exercise or import a MistyStep file to start building your catalog."]</MudText>
                </div>
            }
            else
            {
                <MudSkeleton Height="76px" />
                <MudSkeleton Height="76px" />
                <MudSkeleton Height="76px" />
            }
        </MudStack>
    </div>
    <InputFile id="exerciseImportInput" style="display:none" OnChange="ImportFile" accept=".json,application/json" />
    <MudFabMenu StartIcon="@Icons.Material.Filled.MoreVert" Color="Color.Primary" @bind-Open="IsFabExpanded" Fixed="true" OpenOnMouseHover="false">
        <MudFabMenuItem StartIcon="@Icons.Material.Filled.Add" aria-label="@Localizer["Create exercise"]" title="@Localizer["Create exercise"]" OnClick="GoToExerciseCreation" />
        <MudFabMenuItem StartIcon="@Icons.Material.Filled.FileUpload" aria-label="@Localizer["Import exercises or a program"]" title="@Localizer["Import exercises or a program"]" OnClick="ImportClick" />
    </MudFabMenu>
</div>
@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [Inject] IDialogService DialogService { get; set; } = null!;

    [Inject] IExerciseService ExerciseService { get; set; } = null!;

    [Inject] IJSRuntime JSRuntime { get; set; } = null!;

    [Inject] ISnackbar Snackbar { get; set; } = null!;

    public ObservableCollection<Exercise> Exercises { get; set; } = [];

    private bool IsFabExpanded { get; set; }

    private bool IsLoaded { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var exerciseResult = await ExerciseService.GetExercises();
            if (!exerciseResult.IsSuccess)
            {
                IsLoaded = true;
                StateHasChanged();
                return;
            }
            exerciseResult.Data!.ForEach(exercise => Exercises.Add(exercise));
            IsLoaded = true;
            StateHasChanged();
        }

    }

    private async Task GoToExerciseCreation()
    {
        IsFabExpanded = false;
        var temp = await DialogService.ShowAsync<CreateExerciseDialog>();
        _ = await temp.Result;

        await ReloadExercises();
    }

    private void ToggleFab() => IsFabExpanded = !IsFabExpanded;

    private async Task ImportClick()
    {
        IsFabExpanded = false;
        await JSRuntime.InvokeVoidAsync("clickMistyStepFileInput", "exerciseImportInput");
    }

    private async Task EditExercise(Exercise exercise)
    {
        var parameters = new DialogParameters { ["ExerciseToEdit"] = exercise };
        var dialog = await DialogService.ShowAsync<CreateExerciseDialog>(Localizer["Edit exercise"], parameters);
        _ = await dialog.Result;
        await ReloadExercises();
    }

    private async Task ReloadExercises()
    {
        Exercises.Clear();
        var exerciseResult = await ExerciseService.GetExercises();
        if (exerciseResult.IsSuccess)
        {
            exerciseResult.Data!.ForEach(exercise => Exercises.Add(exercise));
        }

        StateHasChanged();
    }

    private async Task ExportExercise(Exercise exercise)
    {
        var json = await ExerciseService.ExportExerciseAsync(exercise);
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        await JSRuntime.InvokeVoidAsync("downloadMistyStepFile", $"mistystep-exercise-{exercise.Name}.json", base64);
    }

    private async Task DeleteExercise(Exercise exercise)
    {
        var parameters = new DialogParameters
        {
            ["ItemType"] = Localizer["Delete type exercise"].Value,
            ["ItemName"] = exercise.Name,
            ["Details"] = Localizer["This also removes the exercise from every program and deletes its workout records."].Value
        };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(Localizer["Delete exercise"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await ExerciseService.DeleteExerciseAsync(exercise.Id);
        Snackbar.Add(Localizer["Exercise deleted."], Severity.Success);
        await ReloadExercises();
    }

    private async Task ImportFile(InputFileChangeEventArgs args)
    {
        IsFabExpanded = false;
        var file = args.GetMultipleFiles().FirstOrDefault();
        if (file is null)
        {
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(1_000_000);
            using var reader = new StreamReader(stream);
            await ExerciseService.ImportDataAsync(await reader.ReadToEndAsync());
            await ReloadExercises();
            Snackbar.Add(Localizer["Import completed."], Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Localizer["Import failed. Make sure the file is a valid MistyStep export."], Severity.Error);
        }
    }

}